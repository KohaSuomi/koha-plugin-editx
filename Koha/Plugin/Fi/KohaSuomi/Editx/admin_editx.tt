[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: Editx Sanomat</title>
<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<!-- Custom styles -->
<link rel="stylesheet" href="[% PLUGIN_PATH %]/includes/styles.css">
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_editx_tool" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]
    <div id="editxApp">
        <div class="container-fluid py-4">
            <!-- Breadcrumb -->
            <div class="row mb-3">
                <div class="col">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/" class="text-decoration-none">
                                    <i class="bi bi-house-door-fill me-1"></i>Etusivu
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/cgi-bin/koha/plugins/plugins-home.pl" class="text-decoration-none">
                                    <i class="bi bi-plugin me-1"></i>Liitännäiset
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                <i class="bi bi-file-earmark-text me-1"></i>Editx Sanomat
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>

            <!-- Header -->
            <div class="row mb-4">
                <div class="col">
                    <h1 class="display-5 fw-bold text-koha-green">
                        <i class="bi bi-file-earmark-text me-2"></i>Editx Sanomat
                    </h1>
                </div>
            </div>

            <!-- Alerts -->
            <div class="row mb-3" v-if="error || success">
                <div class="col">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" v-if="error">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Virhe!</strong> {{ error }}
                        <button type="button" class="btn-close" @click="error = null" aria-label="Close"></button>
                    </div>
                    <div class="alert alert-success alert-dismissible fade show" role="alert" v-if="success">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>Onnistui!</strong> Tila päivitetty onnistuneesti.
                        <button type="button" class="btn-close" @click="success = false" aria-label="Close"></button>
                    </div>
                </div>
            </div>

            <!-- Main Content Card -->
            <div class="row">
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-header bg-koha-green text-white d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-table me-2"></i>Sanomat
                                <span class="badge bg-white text-koha-green ms-2">{{ total }}</span>
                            </h5>
                            <div class="d-flex align-items-center gap-2">
                                <label class="text-white mb-0 me-2" style="font-size: 0.9rem;">Rivejä sivulla:</label>
                                <select v-model.number="itemsPerPage" class="form-select form-select-sm" style="width: auto;">
                                    <option :value="5">5</option>
                                    <option :value="10">10</option>
                                    <option :value="25">25</option>
                                    <option :value="50">50</option>
                                    <option :value="100">100</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped mb-0" id="contents-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col" style="width: 80px;">ID</th>
                                            <th scope="col">Aikaleima</th>
                                            <th scope="col">Lähetysnumero</th>
                                            <th scope="col" style="width: 150px;">Tila</th>
                                            <th scope="col">Virheilmoitus</th>
                                            <th scope="col" style="width: 200px;" class="text-center">Toiminnot</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-if="contents.length === 0">
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Ei lähetysilmoituksia
                                            </td>
                                        </tr>
                                        <tr v-for="content in contents" :key="content.id">
                                            <td class="align-middle">
                                                <span class="badge bg-secondary">{{ content.id }}</span>
                                            </td>
                                            <td class="align-middle">
                                                {{ new Date(content.timestamp).toLocaleString('fi-FI') }}
                                            </td>
                                            <td class="align-middle">
                                                <strong>{{ content.name }}</strong>
                                            </td>
                                            <td class="align-middle">
                                                <span :class="getStatusBadgeClass(content.status)">
                                                    <i :class="getStatusIcon(content.status)" class="me-1"></i>
                                                    {{ translateStatus(content.status) }}
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                <span v-if="content.status === 'failed'" class="text-danger">
                                                    <i class="bi bi-x-circle-fill me-1"></i>{{ content.statusmessage || 'Käsittely epäonnistui' }}
                                                </span>
                                                <span v-else class="text-muted">-</span>
                                            </td>
                                            <td class="align-middle text-center">
                                                <div class="btn-group" role="group">
                                                    <button 
                                                        v-if="content.status !== 'pending'" 
                                                        @click="setStatus(content.id, 'pending')"
                                                        class="btn btn-sm btn-success"
                                                        title="Laita käsittelyyn">
                                                        <i class="bi bi-play-fill me-1"></i>Laita käsittelyyn
                                                    </button>
                                                    <button 
                                                        v-else 
                                                        @click="setStatus(content.id, 'failed')"
                                                        class="btn btn-sm btn-danger"
                                                        title="Peru käsittely">
                                                        <i class="bi bi-x-circle me-1"></i>Peru käsittely
                                                    </button>
                                                    <button 
                                                        @click="deleteContent(content.id)"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Poista sanoma">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-light" v-if="contents.length > 0">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <p class="mb-0 text-muted small">
                                        Näytetään {{ startIndex }}-{{ endIndex }} / {{ total }} tulosta
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <nav aria-label="Sivutus">
                                        <ul class="pagination pagination-sm justify-content-end mb-0">
                                            <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                <a class="page-link" href="#" @click.prevent="goToPage(1)" aria-label="Ensimmäinen">
                                                    <i class="bi bi-chevron-double-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item" :class="{ disabled: currentPage === 1 }">
                                                <a class="page-link" href="#" @click.prevent="goToPage(currentPage - 1)" aria-label="Edellinen">
                                                    <i class="bi bi-chevron-left"></i>
                                                </a>
                                            </li>
                                            <li class="page-item" v-for="page in visiblePages" :key="page" :class="{ active: page === currentPage }">
                                                <a class="page-link" href="#" @click.prevent="goToPage(page)">{{ page }}</a>
                                            </li>
                                            <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                <a class="page-link" href="#" @click.prevent="goToPage(currentPage + 1)" aria-label="Seuraava">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                            <li class="page-item" :class="{ disabled: currentPage === totalPages }">
                                                <a class="page-link" href="#" @click.prevent="goToPage(totalPages)" aria-label="Viimeinen">
                                                    <i class="bi bi-chevron-double-right"></i>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <!-- Vue 3 and Axios -->
    <script src="[% PLUGIN_PATH %]/includes/vue.global.prod.js"></script>
    <script src="[% PLUGIN_PATH %]/includes/axios.min.js"></script>
    <!-- App script -->
    <script src="[% PLUGIN_PATH %]/js/app.js"></script>
</body>
</html>